# ── 智农 · 生产环境配置 ──────────────────────────────────────
# 复制为 .env 并修改实际值

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret-string
APP_HOST=0.0.0.0
APP_PORT=7860
DEBUG=false

# 数据库 (PostgreSQL 生产 / SQLite 本地开发)
DATABASE_URL=postgresql://zhinong:zhinong_pass@localhost:5432/zhinong
# DATABASE_URL=sqlite:///data/zhinong.db

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# 模型
MODEL_PATH=models/best_multitask_model.pth

# 上传
MAX_UPLOAD_MB=200

# JWT 鉴权
JWT_SECRET=change-me-to-a-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# 管理员初始账号 (首次启动时自动创建)
ADMIN_EMAIL=admin@zhinong.local
ADMIN_PASSWORD=Admin123!

# Sentry 监控 (可选)
SENTRY_DSN=

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
